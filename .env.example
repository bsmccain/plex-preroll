# Plex Server URL (optional, defaults to http://localhost:32400)
PLEX_SERVER_URL=http://localhost:32400

# Plex authentication token (required)
# To find your token, see: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your-plex-token-here

# Path to the YAML configuration file (optional)
# If not set, searches in platform-specific config directories:
#   - Linux: ~/.config/plex-preroll/config.yaml
#   - macOS: ~/Library/Application Support/plex-preroll/config.yaml
#   - Windows: %APPDATA%\plex-preroll\config.yaml
# PLEX_PREROLL_CFG=/path/to/config.yaml
